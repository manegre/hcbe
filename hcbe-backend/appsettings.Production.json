{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSQL",
    "ApplyMigrationsOnStartup": false
  },
  "JwtSettings": {
    "Issuer": "HcbeApi",
    "Audience": "HcbeApi",
    "ExpirationInMinutes": 15,
    "RefreshTokenExpirationInDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ObjectStorage": {
    "Provider": "S3Compatible",
    "Region": "auto",
    "KeyPrefix": "hcbe",
    "ForcePathStyle": false
  },
  "Realtime": {
    "Backplane": "Redis"
  }
}
