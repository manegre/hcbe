{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SQLite",
    "ApplyMigrationsOnStartup": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=hcbe.db"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "HcbeApi",
    "Audience": "HcbeApi",
    "ExpirationInMinutes": 15,
    "RefreshTokenExpirationInDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AssetProxy": {
    "AllowedHosts": []
  },
  "PublicAppUrl": "http://localhost:3000",
  "PublicApiUrl": "http://localhost:8080",
  "Email": {
    "Mode": "Disabled",
    "FromAddress": "noreply@hcbecanada.org",
    "FromName": "HCBE Canada"
  },
  "FileUpload": {
    "MaxFileSize": 10485760,
    "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".jpg", ".jpeg", ".png", ".webp", ".gif" ]
  },
  "ObjectStorage": {
    "Provider": "Local",
    "KeyPrefix": "hcbe",
    "ForcePathStyle": true
  },
  "Privacy": {
    "DeletionDelayDays": 30,
    "AuditRetentionDays": 730
  }
}
