{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SQLite",
    "ApplyMigrationsOnStartup": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=hcbe.db"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "HcbeApi",
    "Audience": "HcbeApi",
    "ExpirationInMinutes": 15,
    "RefreshTokenExpirationInDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Authentication": {
    "Google": {
      "Enabled": false,
      "ClientId": ""
    }
  },
  "AssetProxy": {
    "AllowedHosts": []
  },
  "PublicAppUrl": "http://localhost:3000",
  "PublicApiUrl": "http://localhost:8080",
  "Email": {
    "Mode": "Disabled",
    "FromAddress": "noreply@hcbe.ca",
    "FromName": "HCBE Canada",
    "ReplyToAddress": "contact@hcbe.ca",
    "ContactAddress": "contact@hcbe.ca"
  },
  "FileUpload": {
    "MaxFileSize": 10485760,
    "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".jpg", ".jpeg", ".png", ".webp", ".gif" ]
  },
  "ObjectStorage": {
    "Provider": "Local",
    "KeyPrefix": "hcbe",
    "ForcePathStyle": true
  },
  "Privacy": {
    "DeletionDelayDays": 30,
    "AuditRetentionDays": 730
  },
  "Operations": {
    "AlertEmail": ""
  },
  "DataProtection": {
    "KeyEncryptionKeys": ""
  },
  "Finance": {
    "Enabled": false,
    "Provider": "Stripe",
    "SecretKey": "",
    "WebhookSecret": "",
    "AutomaticTaxEnabled": false,
    "MembershipGracePeriodDays": 30,
    "MinimumDonationCents": 500,
    "Currency": "cad"
  },
  "WalletPasses": {
    "Enabled": false,
    "AppleAddUrlTemplate": "",
    "GoogleAddUrlTemplate": ""
  }
}
