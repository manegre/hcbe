{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "hcbe-backend-jaunty-garden-7362.fly.dev",
  "Database": {
    "Provider": "PostgreSQL",
    "ApplyMigrationsOnStartup": false
  },
  "JwtSettings": {
    "Issuer": "HcbeApi",
    "Audience": "HcbeApi",
    "ExpirationInMinutes": 15,
    "RefreshTokenExpirationInDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://hcbe.vercel.app",
      "https://hcbe-frontend.vercel.app"
    ]
  },
  "PublicAppUrl": "https://hcbe.vercel.app",
  "PublicApiUrl": "https://hcbe-backend-jaunty-garden-7362.fly.dev",
  "FileUpload": {
    "MaxFileSize": 10485760,
    "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".jpg", ".jpeg", ".png", ".webp", ".gif" ],
    "UploadPath": "/app/data/uploads"
  },
  "ObjectStorage": {
    "Provider": "S3Compatible",
    "Region": "auto",
    "KeyPrefix": "hcbe",
    "ForcePathStyle": true
  },
  "Realtime": {
    "Backplane": "Redis"
  }
}
