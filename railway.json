{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/ops/postgres-backup/Dockerfile",
    "watchPatterns": ["/ops/postgres-backup/**", "/railway.json"]
  },
  "deploy": {
    "cronSchedule": "15 3 * * *",
    "restartPolicyType": "NEVER"
  }
}
